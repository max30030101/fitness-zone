# Copy to .env (or export these in your shell / hosting dashboard)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Website name shown everywhere (header, titles, footer, emails, admin)
SITE_NAME=FITNESS ZONE
SITE_URL=http://127.0.0.1:8000

# Email: console backend prints messages in your terminal.
# For Gmail, use an App Password (requires 2-Step Verification), not your normal password.
# To enable Gmail, switch EMAIL_BACKEND to smtp and uncomment the Gmail settings below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=you@gmail.com
DEFAULT_FROM_EMAIL=FITNESS ZONE <no-reply@example.com>

# PostgreSQL (leave POSTGRES_DB unset to use SQLite)
# POSTGRES_DB=fitforge
# POSTGRES_USER=fitforge
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
