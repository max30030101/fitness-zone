# Copy to .env (or export these in your shell / hosting dashboard)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Website name shown everywhere (header, titles, footer, emails, admin)
SITE_NAME=FITNESS ZONE
SITE_URL=http://127.0.0.1:8000

# Email: Gmail SMTP. Use a Google App Password (not your account password).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=project.testemail.assignment@gmail.com
EMAIL_HOST_PASSWORD=jhqn rtml jazj namq
# Optional; defaults to EMAIL_HOST_USER, which must be your Gmail address.
# DEFAULT_FROM_EMAIL=FITNESS ZONE <no-reply@gmail.com>

# PostgreSQL (leave POSTGRES_DB unset to use SQLite)
